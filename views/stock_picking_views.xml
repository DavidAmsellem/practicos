<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_custom_notes" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.custom.notes</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']" position="after">
                <group string="Notas adicionales" name="custom_notes_group" colspan="4">
                    <field name="notes" placeholder="Añadir notas aquí..." nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>