<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_notes" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.notes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']" position="inside">
                <group name="notes_group" string="Notas adicionales">
                    <field name="notes" placeholder="Añadir notas aquí..." nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>